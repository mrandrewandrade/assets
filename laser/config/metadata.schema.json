{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrandrewandrade/assets/laser/config/metadata.schema.json",
  "title": "Technology Commons laser asset metadata",
  "type": "object",
  "required": ["id", "title", "description", "category", "subcategory", "shop", "tool_family", "tags", "technology_areas", "skill_level", "dimensions", "units", "material", "fit_type", "kerf_assumptions", "generator", "parameters", "operations", "files", "editors", "license", "attribution", "source_reference", "sensitivity", "trademark_status", "review_status", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 12},
    "category": {"type": "string"},
    "subcategory": {"type": "string"},
    "shop": {"type": "string"},
    "tool_family": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "technology_areas": {"type": "array", "items": {"enum": ["exploring-technologies", "technological-design", "manufacturing", "construction", "transportation", "computer-technology", "communications-technology", "green-industries", "hairstyling-aesthetics", "hospitality-tourism", "health-care"]}, "minItems": 1, "uniqueItems": true},
    "skill_level": {"enum": ["introductory", "intermediate", "advanced"]},
    "dimensions": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "units": {"const": "mm"},
    "material": {"type": "object", "required": ["name", "measured_thickness_mm", "warning"]},
    "fit_type": {"type": "string"},
    "kerf_assumptions": {"type": "object", "required": ["kerf_mm", "clearance_mm"]},
    "generator": {"type": "object", "required": ["name", "version"]},
    "parameters": {"type": "object"},
    "operations": {"type": "array", "items": {"enum": ["CUT", "SCORE", "ENGRAVE"]}, "minItems": 1, "uniqueItems": true},
    "files": {"type": "object", "required": ["svg", "preview"]},
    "editors": {"type": "array", "items": {"enum": ["Inkscape", "Veccy", "Vectorpea"]}, "minItems": 1},
    "license": {"type": "string"},
    "attribution": {"type": "string"},
    "source_reference": {"type": "string"},
    "sensitivity": {"enum": ["none", "review-recommended", "restricted"]},
    "trademark_status": {"enum": ["original-generic", "public-domain-reference", "third-party-licensed", "review-required"]},
    "review_status": {"enum": ["unverified", "dimension-tested", "fit-tested", "shop-tested"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
